[Unit]
Description=httpdog - nginx access log alerting
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/httpdog --config /etc/httpdog/rules.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# 78 = config error. Restarting will not help, so stay down until someone fixes it
RestartPreventExitStatus=78
# If the main loop does not report for 30 seconds it is treated as hung; systemd kills and restarts it
WatchdogSec=30

# Logs arrive on a unix socket that httpdog creates in this directory: /run/httpdog/httpdog.sock,
# the default `listen` of the rule file
RuntimeDirectory=httpdog
# Whoever can write to that socket can make httpdog raise alerts. httpdog creates it writable by itself only;
# this line then lets in one group, the one nginx's workers run as, and nobody else.
# www-data is right for Debian / Ubuntu. On Fedora / Rocky Linux change it to nginx.
# The + runs it as root: httpdog is deliberately not a member of the web server's group, so it cannot
# hand the socket over itself. When `listen` in the rule file is a UDP address there is no socket and this does nothing
ExecStartPost=+/bin/sh -c 'if [ -S /run/httpdog/httpdog.sock ]; then chgrp www-data /run/httpdog/httpdog.sock; fi'

# A ceiling on memory. httpdog normally uses a few megabytes. What can grow is the state of rules with
# group_by: one counter for every group being counted (docs/limits.md has the numbers). At the ceiling the
# kernel kills httpdog and systemd starts it again with empty counters: a last resort that keeps the rest of
# the machine running. MemorySwapMax=0 makes that happen at once, instead of httpdog first slowing down in swap
MemoryMax=256M
MemorySwapMax=0

# Secrets such as the webhook URL go here (mode 600, root). The leading - means a missing file is not an error
EnvironmentFile=-/etc/httpdog/secrets.env

# No account to create in advance: systemd allocates an unprivileged identity at start
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
