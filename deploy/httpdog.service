[Unit]
Description=httpdog - nginx access log alerting
After=network-online.target httpdog.socket
Wants=network-online.target
# Logs arrive on the socket of httpdog.socket, which decides its path and who can write to it.
# When `listen` in the rule file is a UDP address, see docs/log-format.md
Requires=httpdog.socket
# At most 5 starts in 10 seconds, which is systemd's default, spelled out because this unit depends on it.
# While httpdog is down, a log line waiting in the socket makes systemd start it at once. When the start
# itself fails (a rule file error, say) that would repeat without end; with this limit systemd gives up
# after 5 tries and stops the socket as well. After fixing the cause, systemctl start httpdog brings both
# back (within the same 10 seconds it needs systemctl reset-failed httpdog first)
StartLimitIntervalSec=10
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/local/bin/httpdog --config /etc/httpdog/rules.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# 78 = config error. Restarting will not help, so stay down until someone fixes it
RestartPreventExitStatus=78
# If the main loop does not report for 30 seconds it is treated as hung; systemd kills and restarts it
WatchdogSec=30

# A ceiling on memory. httpdog normally uses a few megabytes. What can grow is the state of rules with
# group_by: one counter for every group being counted (docs/limits.md has the numbers). At the ceiling the
# kernel kills httpdog and systemd starts it again with empty counters: a last resort that keeps the rest of
# the machine running. MemorySwapMax=0 makes that happen at once, instead of httpdog first slowing down in swap
MemoryMax=256M
MemorySwapMax=0

# Secrets such as the webhook URL go here (mode 600, root). The leading - means a missing file is not an error
EnvironmentFile=-/etc/httpdog/secrets.env

# No account to create in advance: systemd allocates an unprivileged identity at start
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
Also=httpdog.socket
